<header class="site-header">

  <!-- Mobile menu -->
  <nav class="mobile-menu">
    <button class="close-btn" aria-label="Close menu">✕</button>
    <div class="logo">
      <a href="{{ routes.root_url }}">TISSO VISON</a>
    </div>
    <div style="visibility: hidden;"></div>

    <ul> 
      <li><p>Find the ideal gift for your loved ones.</p></li>
      <li><a href="/collections/all" class="btn-choose-mobile">CHOOSE GIFT →</a></li>
    </ul>
  </nav>

  <!-- Top info bar -->
  <div class="top-bar">
    <!-- Hamburger for mobile -->

    <button class="hamburger" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="logo">
      <a href="{{ routes.root_url }}">TISSO VISON</a>
    </div>

    <div style="visibility: hidden;"></div>

    <p>Find the ideal gift for your loved ones.</p>
    <a href="/collections/all" class="btn-choose">CHOOSE GIFT →</a>
  </div>

</header>

{% schema %}
