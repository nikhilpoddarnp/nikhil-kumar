  "name": "Custom Header",
  "settings": [],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}

<style>
/* Mobile menu overlay */
.mobile-menu {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: #fff;
  padding: 2rem 1rem;
  z-index: 9999; /* show on top of banner */
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}
.site-header {
  position: fixed;
  width: 100%;
}
.banner {
margin-top: 80px;
}

.mobile-menu ul {
  list-style: none;
  margin: 2rem 0 0;
  padding: 0;
  text-align: center;
}

.mobile-menu li {
  margin: 1rem 0;
}

.mobile-menu a {
  text-decoration: none;
  color: #000;
  font-size: 1.2rem;
}

/* Close button inside menu */
.close-btn {
  position: absolute;
  top: 15px;
  right: 20px;
  font-size: 24px;
  background: none;
  border: none;
  cursor: pointer;
}

/* Hamburger styles */
.hamburger {
  display: none;
  flex-direction: column;
  justify-content: space-between;
  width: 25px;
  height: 20px;
  background: none;
  border: none;
  cursor: pointer;
  z-index: 10000;
}

.hamburger span {
  height: 3px;
  background: #000;
  border-radius: 2px;
  display: block;
}

/* Show hamburger only on mobile */
@media (max-width: 768px) {
  .hamburger {
    display: flex;
  }

  .btn-choose, 
  .top-bar p {
    display: none; /* Hide text + button in top-bar for mobile */
  }
}
.btn-choose-mobile {
    margin-top: 10px;
    padding: 1rem 9rem ;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const hamburger = document.querySelector(".hamburger");
  const mobileMenu = document.querySelector(".mobile-menu");
  const closeBtn = document.querySelector(".close-btn");

  hamburger.addEventListener("click", function () {
    mobileMenu.style.display = "flex";
  });

  closeBtn.addEventListener("click", function () {
    mobileMenu.style.display = "none";
  });
});
</script>
